{
    "name": "componenta/validation-app",
    "description": "Application building of declarative validation maps with native attribute fallback",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "componenta",
        "validation",
        "attributes",
        "build"
    ],
    "require": {
        "php": "^8.4",
        "componenta/app": "^5.0.0",
        "componenta/class-finder": "^2.1.0",
        "componenta/config": "^3.0.0",
        "componenta/di": "^5.0.3",
        "componenta/tokenizer": "^1.0",
        "componenta/validation": "^3.0.1",
        "componenta/var-export": "^2.0.0",
        "psr/container": "^2.0",
        "componenta/path-resolver": "^1.0",
        "nikic/php-parser": "^5.8"
    },
    "require-dev": {
        "componenta/app-console": "^5.0.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Validation\\App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\Validation\\App\\Tests\\": "tests/"
        }
    },
    "extra": {
        "componenta": {
            "config-providers": [
                "Componenta\\Validation\\App\\ConfigProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "3.0.x-dev"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "test:integration": "@composer --working-dir=integration test"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
