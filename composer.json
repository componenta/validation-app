{
    "name": "componenta/validation-app",
    "description": "Componenta application integration for compiled validation metadata",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "componenta",
        "validation",
        "attributes",
        "compilation"
    ],
    "require": {
        "php": "^8.4",
        "componenta/app": "^3.0.2",
        "componenta/class-finder": "^1.0",
        "componenta/config": "^2.0.2",
        "componenta/di": "^4.0.2",
        "componenta/tokenizer": "^1.0",
        "componenta/validation": "^2.0.0",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "componenta/app-console": "^3.0.2",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Validation\\App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\Validation\\App\\Tests\\": "tests/"
        }
    },
    "extra": {
        "componenta": {
            "config-providers": [
                "Componenta\\Validation\\App\\ConfigProvider"
            ]
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
